-- ===== FLY SYSTEM =====
local flying, currentSpeed, verticalSpeed = false, 50, 35
local camera = workspace.CurrentCamera
local humanoid, rootPart, flySteppedConnection

local function setupFlyChar(char)
    humanoid = char:FindFirstChildOfClass("Humanoid")
    rootPart = char:FindFirstChild("HumanoidRootPart")
end
Player.CharacterAdded:Connect(setupFlyChar)
if Character then setupFlyChar(Character) end

local function startFly()
    if not rootPart or not rootPart.Parent then return end
    flying = true
    if humanoid then humanoid.PlatformStand = true end
    if flySteppedConnection then flySteppedConnection:Disconnect() end
    flySteppedConnection = RunService.Stepped:Connect(function()
        if not flying or not rootPart or not rootPart.Parent then return end
        local W = UserInputService:IsKeyDown(Enum.KeyCode.W)
        local A = UserInputService:IsKeyDown(Enum.KeyCode.A)
        local S = UserInputService:IsKeyDown(Enum.KeyCode.S)
        local D = UserInputService:IsKeyDown(Enum.KeyCode.D)
        local Space = UserInputService:IsKeyDown(Enum.KeyCode.Space)
        local Ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        if not (W or A or S or D or Space or Ctrl) then rootPart.Velocity = Vector3.new(0, 0, 0)
        else
            local dir = Vector3.new(0, 0, 0)
            if W then dir = dir + camera.CFrame.LookVector end
            if S then dir = dir - camera.CFrame.LookVector end
            if A then dir = dir - camera.CFrame.RightVector end
            if D then dir = dir + camera.CFrame.RightVector end
            if dir.Magnitude > 0 then dir = dir.Unit end
            local vertical = 0
            if Space then vertical = verticalSpeed end
            if Ctrl then vertical = -verticalSpeed end
            rootPart.Velocity = (dir * currentSpeed) + Vector3.new(0, vertical, 0)
        end
    end)
end

local function stopFly()
    flying = false
    if flySteppedConnection then flySteppedConnection:Disconnect() flySteppedConnection = nil end
    if rootPart then rootPart.Velocity = Vector3.new(0, 0, 0) end
    if humanoid then humanoid.PlatformStand = false end
end

-- ===== INFINITE JUKE TOGGLE SYSTEM =====
local function updateJukeUI(state)
    local labelText = state and "Juke: ON" or "Juke: OFF"
    local bgColor = state and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(75, 0, 130)
    
    jukeBtn.Text = labelText
    jukeBtn.BackgroundColor3 = bgColor
    
    if UI_Elements.JukeCircle then
        local mobileLabel = UI_Elements.JukeCircle:FindFirstChildOfClass("TextLabel")
        if mobileLabel then
            mobileLabel.Text = state and "JUKE\nON" or "⚡\nJUKE"
            mobileLabel.TextColor3 = state and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(170, 0, 255)
        end
    end
end

local function toggleJuke()
    jukeEnabled = not jukeEnabled
    updateJukeUI(jukeEnabled)
    
    if jukeEnabled then
        task.spawn(function()
            while jukeEnabled do
                if not Character then task.wait(0.1) continue end
                local hrp = Character:FindFirstChild("HumanoidRootPart")
                local hum = Character:FindFirstChildOfClass("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    -- 3x Spam Jump Loop
                    for i = 1, 3 do
                        if not jukeEnabled or not hrp or hum.Health <= 0 then break end
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 52, hrp.Velocity.Z)
                        task.wait(0.12)
                    end
                    task.wait(0.05)
                    -- Instant TP Down Execution
                    if jukeEnabled and hrp and hum.Health > 0 then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, -220, hrp.Velocity.Z)
                    end
                end
                task.wait(0.25) -- Kleiner Cooldown zwischen den Jukes
            end
        end)
    end
end

jukeBtn.MouseButton1Click:Connect(toggleJuke)

-- ===== FPS BOOSTER SYSTEM =====
local function setFPSBooster(state)
    fpsBoosterEnabled = state
    fpsBoosterBtn.Text = state and "FPS BOOSTER: ON" or "FPS BOOSTER: OFF"
    fpsBoosterBtn.BackgroundColor3 = state and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(40, 40, 40)
    
    local lighting = game:GetService("Lighting")
    if state then
        -- Boost ON: High Performance mit guter Grafik
        -- Wir behalten die QualityLevel bei, optimieren aber schwere Effekte
        lighting.GlobalShadows = false
        lighting.CastShadows = false
        
        -- Nur wirklich schwere Partikel/Effekte deaktivieren, Decals behalten
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Explosion") then
                v.Enabled = false
            elseif v:IsA("PostProcessEffect") then -- Bloom, Blur etc.
                v.Enabled = false
            end
        end
    else
        -- Boost OFF: Alles wieder an
        lighting.GlobalShadows = true
        lighting.CastShadows = true
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Explosion") then
                v.Enabled = true
            elseif v:IsA("PostProcessEffect") then
                v.Enabled = true
            end
        end
    end
end

fpsBoosterBtn.MouseButton1Click:Connect(function()
    setFPSBooster(not fpsBoosterEnabled)
    task.delay(0.1, saveConfig)
end)

-- ===== ANTI RAGDOLL SYSTEM =====
local antiRagdollEnabled = false
local ragdollConnection, autoStopTask
local function setupAntiRagdoll()
    if ragdollConnection then ragdollConnection:Disconnect() ragdollConnection = nil end
    if not antiRagdollEnabled then return end
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    ragdollConnection = hum.StateChanged:Connect(function(oldState, newState)
        if not antiRagdollEnabled then return end
        if newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.FallingDown or newState == Enum.HumanoidStateType.Physics then
            if not flying then startFly() end
            if autoStopTask then task.cancel(autoStopTask) end
            autoStopTask = task.delay(4.3, function() if flying then stopFly() end autoStopTask = nil end)
        end
    end)
end

-- ===== AUTO BAT TARGET ENGINE =====
local function getClosestPlayer()
    local closestTarget, shortestDistance = nil, math.huge
    local myRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
            if p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < shortestDistance then shortestDistance = dist; closestTarget = p.Character end
            end
        end
    end
    return closestTarget
end

RunService.Heartbeat:Connect(function()
    if autoBatEnabled and Character and Character:FindFirstChild("HumanoidRootPart") then
        local hum = Character:FindFirstChildOfClass("Humanoid")
        local target = getClosestPlayer()
        if target and target:FindFirstChild("HumanoidRootPart") and hum and hum.Health > 0 then
            local bat = Player.Backpack:FindFirstChild("Bat") or Character:FindFirstChild("Bat")
            if bat and bat.Parent == Player.Backpack then bat.Parent = Character end
            local myRoot = Character.HumanoidRootPart
            local targetRoot = target.HumanoidRootPart
            local distance = (targetRoot.Position - myRoot.Position).Magnitude
            myRoot.CFrame = CFrame.new(myRoot.Position, Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z))
            camera.CFrame = CFrame.new(camera.CFrame.Position, targetRoot.Position)
            if distance > 3.5 then hum:MoveTo(targetRoot.Position)
            else hum:Move(Vector3.new(0, 0, 0)) if bat and bat:IsA("Tool") then bat:Activate() end end
        end
    end
end)

-- ==================== CONFIG HANDLING ====================
local configFolder = "JaysonHub"
local function getConfigPath() return configFolder .. "/config_" .. Player.UserId .. ".json" end
local function UDim2ToTable(ud) return {ud.X.Scale, ud.X.Offset, ud.Y.Scale, ud.Y.Offset} end
local function TableToUDim2(t) if not t then return nil end return UDim2.new(t[1], t[2], t[3], t[4]) end

local function saveConfig()
    if not isfolder(configFolder) then makefolder(configFolder) end
    local positions = {}
    for key, instance in pairs(UI_Elements) do
        if instance and instance.Parent then positions[key] = UDim2ToTable(instance.Position) savedPositions[key] = positions[key]
        elseif savedPositions[key] then positions[key] = savedPositions[key] end
    end
	local config = {antiRagdollEnabled = antiRagdollEnabled, infiniteJumpEnabled = infiniteJumpEnabled, mobileButtonsActive = mobileButtonsActive, autoBatEnabled = autoBatEnabled, jukeEnabled = jukeEnabled, fpsBoosterEnabled = fpsBoosterEnabled, positions = positions}
    pcall(function() writefile(getConfigPath(), HttpService:JSONEncode(config)) end)
end

