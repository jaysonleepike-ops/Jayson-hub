local function createMobileButtons()
    local dragDeltaThreshold = 5

    local function createCircle(name, text, defaultPos, onClick)
        local sg = Instance.new("ScreenGui", Player:WaitForChild("PlayerGui"))
        sg.Name = name; table.insert(mobileGUIs, sg)
        local frame = Instance.new("Frame", sg)
        frame.Size, frame.BackgroundColor3, frame.BorderSizePixel, frame.Active = UDim2.new(0, 55, 0, 55), Color3.fromRGB(12,12,12), 0, true
        frame.Position = TableToUDim2(savedPositions[name]) or defaultPos
        UI_Elements[name] = frame; MakeElementDraggable(frame)
        Instance.new("UICorner", frame).CornerRadius = UDim.new(1,0)
        local lbl = Instance.new("TextLabel", frame)
        lbl.Size, lbl.BackgroundTransparency, lbl.Text, lbl.Font, lbl.TextSize, lbl.TextColor3 = UDim2.new(1,0,1,0), 1, text, Enum.Font.GothamBold, 13, Color3.fromRGB(170,0,255)
        local start
        frame.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then start = i.Position end end)
        frame.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then if start and (i.Position - start).Magnitude < dragDeltaThreshold then onClick(lbl, frame) end end end)
    end

    createCircle("DropCircle", "DROP\nBR", UDim2.new(0.82, -27, 0.55, 0), function()
        local rPart, hum = Character:FindFirstChild("HumanoidRootPart"), Character:FindFirstChildOfClass("Humanoid")
        if rPart and hum and hum.Health > 0 then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false) rPart.Velocity = Vector3.new(rPart.Velocity.X, 160, rPart.Velocity.Z)
            task.wait(0.15) rPart.Velocity = Vector3.new(rPart.Velocity.X, -95, rPart.Velocity.Z)
            task.wait(0.28) if hum and hum.Parent then hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end
        end
    end)

    createCircle("FlyCircle", "FLY", UDim2.new(0.82, -60, 0.38, 0), function(lbl)
        if flying and currentSpeed == 50 then stopFly() lbl.Text = "FLY" else currentSpeed = 50; startFly() lbl.Text = "ON" end
    end)

    createCircle("CarryCircle", "FLY\nCARRY", UDim2.new(0.82, 5, 0.38, 0), function(lbl)
        if flying and currentSpeed == 29 then stopFly() lbl.Text = "FLY\nCARRY" else currentSpeed = 29; startFly() lbl.Text = "ON" end
    end)

    createCircle("TpDownCircle", "TP\nDOWN", UDim2.new(0.82, -27, 0.72, 0), function()
        if Character and Character:FindFirstChild("HumanoidRootPart") then Character.HumanoidRootPart.Velocity = Vector3.new(Character.HumanoidRootPart.Velocity.X, -200, Character.HumanoidRootPart.Velocity.Z) end
    end)

    createCircle("JukeCircle", jukeEnabled and "JUKE\nON" or "⚡\nJUKE", UDim2.new(0.72, -85, 0.55, 0), function() toggleJuke() end)
    UI_Elements.JukeCircle.BackgroundColor3 = Color3.fromRGB(75, 0, 130)
    if jukeEnabled then updateJukeUI(true) end

    createCircle("AutoBatCircle", autoBatEnabled and "BAT\nON" or "AUTO\nBAT", UDim2.new(0.72, -27, 0.55, 0), function(lbl)
        autoBatEnabled = not autoBatEnabled
        if autoBatEnabled then lbl.Text = "BAT\nON" lbl.TextColor3 = Color3.fromRGB(0, 255, 100) else lbl.Text = "AUTO\nBAT" lbl.TextColor3 = Color3.fromRGB(255, 150, 0) end
    end)
end

