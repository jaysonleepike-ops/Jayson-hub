-- ===== FLY SYSTEM =====
local function setupFlyChar(char)
    humanoid = char:FindFirstChild("Humanoid")
    rootPart = char:FindFirstChild("HumanoidRootPart")
end

Player.CharacterAdded:Connect(setupFlyChar)
if Character then setupFlyChar(Character) end

local function startFly()
    if not rootPart or not rootPart.Parent then return end
    flying = true
    
    if humanoid then
        humanoid.PlatformStand = true
    end
    
    if flySteppedConnection then flySteppedConnection:Disconnect() end
    
    flySteppedConnection = RunService.Stepped:Connect(function()
        if not flying or not rootPart or not rootPart.Parent then return end
        
        local pressingW = UserInputService:IsKeyDown(Enum.KeyCode.W)
        local pressingA = UserInputService:IsKeyDown(Enum.KeyCode.A)
        local pressingS = UserInputService:IsKeyDown(Enum.KeyCode.S)
        local pressingD = UserInputService:IsKeyDown(Enum.KeyCode.D)
        local pressingSpace = UserInputService:IsKeyDown(Enum.KeyCode.Space)
        local pressingCtrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        
        if not (pressingW or pressingA or pressingS or pressingD or pressingSpace or pressingCtrl) then
            rootPart.Velocity = Vector3.new(0, 0, 0)
        else
            local dir = Vector3.new(0, 0, 0)
            if pressingW then dir = dir + camera.CFrame.LookVector end
            if pressingS then dir = dir - camera.CFrame.LookVector end
            if pressingA then dir = dir - camera.CFrame.RightVector end
            if pressingD then dir = dir + camera.CFrame.RightVector end
            
            if dir.Magnitude > 0 then dir = dir.Unit end
            
            local vertical = 0
            if pressingSpace then vertical = verticalSpeed end
            if pressingCtrl then vertical = -verticalSpeed end
            
            rootPart.Velocity = (dir * currentSpeed) + Vector3.new(0, vertical, 0)
        end
    end)
end

local function stopFly()
    flying = false
    if flySteppedConnection then
        flySteppedConnection:Disconnect()
        flySteppedConnection = nil
    end
    if rootPart then
        rootPart.Velocity = Vector3.new(0, 0, 0)
    end
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- ===== ANTI RAGDOLL SYSTEM (4.3s Auto Deactivate) =====
local function setupAntiRagdoll()
    if ragdollConnection then
        ragdollConnection:Disconnect()
        ragdollConnection = nil
    end
    
    if not antiRagdollEnabled then return end
    
    local char = Player.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    
    ragdollConnection = hum.StateChanged:Connect(function(oldState, newState)
        if not antiRagdollEnabled then return end
        
        if newState == Enum.HumanoidStateType.Ragdoll or 
           newState == Enum.HumanoidStateType.FallingDown or
           newState == Enum.HumanoidStateType.Physics then
            
            if not flying then
                print("🟢 Ragdoll detected! Activating Fly for 4.3 seconds...")
                startFly()
            end
            
            -- Cancel old timer
            if autoStopTask then
                task.cancel(autoStopTask)
            end
            
            -- Auto deactivate after 4.3 seconds
            autoStopTask = task.delay(4.3, function()
                if flying then
                    print("⏰ 4.3 seconds passed - Deactivating Fly")
                    stopFly()
                end
                autoStopTask = nil
            end)
        end
    end)
end

-- ===== ANTI RAGDOLL TOGGLE =====
antiRagdollBtn.MouseButton1Click:Connect(function()
    antiRagdollEnabled = not antiRagdollEnabled
    
    if antiRagdollEnabled then
        antiRagdollBtn.Text = "Anti Ragdoll: ON"
        antiRagdollBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 90)
        setupAntiRagdoll()
    else
        antiRagdollBtn.Text = "Anti Ragdoll: OFF"
        antiRagdollBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        
        if ragdollConnection then
            ragdollConnection:Disconnect()
            ragdollConnection = nil
        end
        if autoStopTask then
            task.cancel(autoStopTask)
            autoStopTask = nil
        end
        if flying then
            stopFly()
        end
    end
end)

Player.CharacterAdded:Connect(function(char)
    Character = char
