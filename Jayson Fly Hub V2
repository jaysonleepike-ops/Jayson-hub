-- ==================== DRAGGABLE ====================
local function makeDraggable(frame)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(mainFrame)

-- ==================== VARIABLES ====================
local flying = false
local speed = 50
local verticalSpeed = 35
local camera = workspace.CurrentCamera

-- ==================== FLY LOGIC (weniger Rubberband) ====================
RunService.Heartbeat:Connect(function()
    if not flying or not rootPart or not rootPart.Parent then return end
    
    local horizontalDir = Vector3.new(0, 0, 0)

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then 
        horizontalDir = horizontalDir + camera.CFrame.LookVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then 
        horizontalDir = horizontalDir - camera.CFrame.LookVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then 
        horizontalDir = horizontalDir - camera.CFrame.RightVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then 
        horizontalDir = horizontalDir + camera.CFrame.RightVector 
    end

    if horizontalDir.Magnitude > 0 then
        horizontalDir = horizontalDir.Unit
    end

    local horizontalVel = horizontalDir * speed

    local verticalVel = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then 
        verticalVel = verticalSpeed
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then 
        verticalVel = -verticalSpeed
    end

    local targetVel = horizontalVel + Vector3.new(0, verticalVel, 0)

    -- Idle Hover
    if targetVel.Magnitude == 0 then
        if rootPart.Velocity.Y < 0 then
            targetVel = Vector3.new(0, 2.8, 0)
        else
            targetVel = Vector3.new(0, 0, 0)
        end
    end

    -- Smooth Velocity (weniger zurück laggen)
    rootPart.Velocity = rootPart.Velocity:Lerp(targetVel, 0.8)

    -- Anti-Spin
    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end)

-- ==================== TOGGLE FLY ====================
local function toggleFly()
    flying = not flying
    
    if flying then
        flyButton.Text = "FLY: ON"
        flyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
    else
        flyButton.Text = "FLY: OFF"
        flyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        if rootPart then rootPart.Velocity = Vector3.new(0, 0, 0) end
    end
end

flyButton.MouseButton1Click:Connect(toggleFly)

