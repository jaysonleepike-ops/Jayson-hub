-- ==================== DRAGGABLE ====================
local function makeDraggable(frame)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end
makeDraggable(mainFrame)

-- ==================== VARIABLES ====================
local flying = false
local speed = 50
local verticalSpeed = 35
local camera = workspace.CurrentCamera

-- ==================== FLY LOGIC ====================
RunService.Stepped:Connect(function()
    if not flying or not rootPart or not rootPart.Parent then return end

    -- Godmode
    if humanoid then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        humanoid.BreakJointsOnDeath = false
        pcall(function() humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
    end

    local pressingW = UserInputService:IsKeyDown(Enum.KeyCode.W)
    local pressingA = UserInputService:IsKeyDown(Enum.KeyCode.A)
    local pressingS = UserInputService:IsKeyDown(Enum.KeyCode.S)
    local pressingD = UserInputService:IsKeyDown(Enum.KeyCode.D)
    local pressingSpace = UserInputService:IsKeyDown(Enum.KeyCode.Space)
    local pressingCtrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)

    local anyKeyPressed = pressingW or pressingA or pressingS or pressingD or pressingSpace or pressingCtrl

    if not anyKeyPressed then
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    else
        local horizontalDir = Vector3.new(0, 0, 0)

        if pressingW then horizontalDir = horizontalDir + camera.CFrame.LookVector end
        if pressingS then horizontalDir = horizontalDir - camera.CFrame.LookVector end
        if pressingA then horizontalDir = horizontalDir - camera.CFrame.RightVector end
        if pressingD then horizontalDir = horizontalDir + camera.CFrame.RightVector end

        if horizontalDir.Magnitude > 0 then
            horizontalDir = horizontalDir.Unit
        end

        local horizontalVel = horizontalDir * speed
        local verticalVel = 0

        if pressingSpace then verticalVel = verticalSpeed end
        if pressingCtrl then verticalVel = -verticalSpeed end

        local targetVel = horizontalVel + Vector3.new(0, verticalVel, 0)
        rootPart.Velocity = rootPart.Velocity:Lerp(targetVel, 0.9)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end

    -- ==================== FULL 3D LOOK (FIXED) ====================
    if camera then
        rootPart.CFrame = CFrame.new(rootPart.Position) * camera.CFrame.Rotation
    end
    -- ============================================================
end)

-- ==================== TOGGLE FLY ====================
local function toggleFly()
    flying = not flying
    if flying then
        flyButton.Text = "FLY: ON"
        flyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        humanoid.PlatformStand = true
        humanoid.AutoRotate = false
    else
        flyButton.Text = "FLY: OFF"
        flyButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
        if rootPart then rootPart.Velocity = Vector3.new(0, 0, 0) end
    end
end

flyButton.MouseButton1Click:Connect(toggleFly)

